# API.Football (RapidAPI) - https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=la_tua_chiave_qui
API_FOOTBALL_HOST=v3.football.api-sports.io

# Gemini API (per commento AI sulle value bet) - aistudio.google.com, gratuito
# Se lasci vuoto, il sistema funziona comunque, semplicemente senza il commento
# in linguaggio naturale.
GEMINI_API_KEY=

# Database (Supabase Postgres o altro)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Leghe da seguire (ID API.Football, separati da virgola)
# 135 = Serie A, 39 = Premier League
LEAGUE_IDS=135,39

# Bankroll iniziale (EUR)
INITIAL_BANKROLL=100

# Kelly frazionato (es. 0.25 = 1/4 Kelly)
KELLY_FRACTION=0.25

# Cap massimo per singola scommessa (% del bankroll)
MAX_STAKE_PCT=0.05

# Stop-loss settimanale (% del bankroll)
WEEKLY_STOP_LOSS_PCT=0.15

PORT=3000
